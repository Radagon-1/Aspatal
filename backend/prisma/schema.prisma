// This is your Prisma schema file for the Aspatal healthcare platform
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────

enum Role {
  ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  ASHA_WORKER
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BedType {
  ICU
  NORMAL
  EMERGENCY
  NICU
  MATERNITY
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TriageUrgency {
  EMERGENCY
  URGENT
  STANDARD
  NON_URGENT
}

enum FacilityLevel {
  SUB_CENTRE
  PHC
  CHC
  RURAL_HOSPITAL
  DISTRICT_HOSPITAL
  TERTIARY
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
  DECEASED
}

// ─── Auth & Users ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  googleId      String?   @unique
  role          Role      @default(PATIENT)
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations — a user can be linked to one of these profiles
  patient       Patient?
  doctor        Doctor?
  ashaWorker    AshaWorker?
  hospitalAdmin HospitalAdmin?

  refreshTokens RefreshToken[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ─── Hospital ──────────────────────────────────────────────

model Hospital {
  id               String       @id @default(cuid())
  name             String
  address          String
  city             String
  district         String
  state            String       @default("Maharashtra")
  pincode          String
  phone            String
  frontDeskPhone   String?
  email            String?
  facilityLevel    FacilityLevel
  totalRooms       Int          @default(0)
  totalBeds        Int          @default(0)
  totalFloors      Int          @default(1)
  totalStaff       Int          @default(0)
  landArea         String?      // in sq ft or acres
  buildingArea     String?
  latitude         Float?
  longitude        Float?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  admins           HospitalAdmin[]
  doctors          Doctor[]
  beds             Bed[]
  patients         Patient[]     // patients currently registered here
  appointments     Appointment[]
  medicines        Medicine[]
  machines         Machine[]
  pharmacies       Pharmacy[]
  referralsFrom    Referral[]    @relation("ReferralFrom")
  referralsTo      Referral[]    @relation("ReferralTo")
  admissions       Admission[]
  visits           Visit[]

  @@index([district, state])
  @@index([facilityLevel])
}

model HospitalAdmin {
  id         String   @id @default(cuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

// ─── Doctor ────────────────────────────────────────────────

model Doctor {
  id              String   @id @default(cuid())
  userId          String   @unique
  hospitalId      String
  name            String
  specialization  String
  qualification   String?
  experience      Int?     // years
  phone           String?
  isAvailable     Boolean  @default(true)
  consultationFee Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  visits       Visit[]
  appointments Appointment[]
  referralsBy  Referral[]    @relation("ReferredByDoctor")
  referralsTo  Referral[]    @relation("ReferredToDoctor")

  @@index([hospitalId])
  @@index([specialization])
}

// ─── Patient ───────────────────────────────────────────────

model Patient {
  id                  String   @id @default(cuid())
  userId              String   @unique
  hospitalId          String?
  name                String
  age                 Int
  gender              Gender
  phone               String?
  email               String?
  address             String?
  bloodGroup          String?
  existingConditions  String[] // array of conditions
  currentMedications  String[] // array of medications
  knownAllergies      String[] // array of allergies
  emergencyContact    String?
  emergencyPhone      String?
  pregnancyStatus     Boolean  @default(false)
  isHighRisk          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital      Hospital?      @relation(fields: [hospitalId], references: [id])
  visits        Visit[]
  admissions    Admission[]
  referrals     Referral[]
  appointments  Appointment[]
  followUps     FollowUp[]
  triageRecords TriageRecord[]
  ashaVisits    AshaVisit[]

  @@index([hospitalId])
  @@index([name])
  @@index([phone])
}

// ─── Visit (Doctor Consultation) ───────────────────────────

model Visit {
  id                    String   @id @default(cuid())
  patientId             String
  doctorId              String
  hospitalId            String
  visitDate             DateTime @default(now())
  symptoms              String[] // array of symptoms
  diagnosis             String?
  prescriptions         String[] // array of medications prescribed
  medicalTestsOrdered   String[] // tests ordered
  bloodPressureSystolic Int?
  bloodPressureDiastolic Int?
  bodyTemperature       Float?   // in Celsius
  heartRate             Int?
  oxygenSaturation      Float?
  weight                Float?   // in kg
  height                Float?   // in cm
  notes                 String?
  toBeAdmitted          Boolean  @default(false)
  needsReferral         Boolean  @default(false)
  needsFollowUp         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    Doctor     @relation(fields: [doctorId], references: [id])
  hospital  Hospital   @relation(fields: [hospitalId], references: [id])
  referral  Referral?
  followUp  FollowUp?
  admission Admission?

  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([visitDate])
}

// ─── Admission ─────────────────────────────────────────────

model Admission {
  id              String          @id @default(cuid())
  patientId       String
  hospitalId      String
  visitId         String?         @unique
  bedId           String?
  bedType         BedType
  roomNumber      String?
  wardName        String?
  admittedAt      DateTime        @default(now())
  dischargedAt    DateTime?
  status          AdmissionStatus @default(ADMITTED)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  visit    Visit?   @relation(fields: [visitId], references: [id])
  bed      Bed?     @relation(fields: [bedId], references: [id])

  @@index([patientId])
  @@index([hospitalId])
  @@index([status])
}

// ─── Bed ───────────────────────────────────────────────────

model Bed {
  id         String    @id @default(cuid())
  hospitalId String
  bedNumber  String
  roomNumber String?
  wardName   String?
  floor      Int       @default(1)
  bedType    BedType   @default(NORMAL)
  status     BedStatus @default(AVAILABLE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  admissions Admission[]

  @@unique([hospitalId, bedNumber])
  @@index([hospitalId, status])
  @@index([bedType])
}

// ─── Referral ──────────────────────────────────────────────

model Referral {
  id                    String         @id @default(cuid())
  patientId             String
  visitId               String         @unique
  fromHospitalId        String
  toHospitalId          String
  referredByDoctorId    String
  referredToDoctorId    String?
  reason                String
  status                ReferralStatus @default(PENDING)
  previousVisitSummary  String?
  notes                 String?
  referredAt            DateTime       @default(now())
  acceptedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit          Visit    @relation(fields: [visitId], references: [id])
  fromHospital   Hospital @relation("ReferralFrom", fields: [fromHospitalId], references: [id])
  toHospital     Hospital @relation("ReferralTo", fields: [toHospitalId], references: [id])
  referredBy     Doctor   @relation("ReferredByDoctor", fields: [referredByDoctorId], references: [id])
  referredTo     Doctor?  @relation("ReferredToDoctor", fields: [referredToDoctorId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([fromHospitalId])
  @@index([toHospitalId])
}

// ─── Follow-Up ─────────────────────────────────────────────

model FollowUp {
  id              String   @id @default(cuid())
  patientId       String
  visitId         String   @unique
  scheduledDate   DateTime
  reason          String
  testReports     String[] // uploaded report references
  isCompleted     Boolean  @default(false)
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit   Visit   @relation(fields: [visitId], references: [id])

  @@index([patientId])
  @@index([scheduledDate])
  @@index([isCompleted])
}

// ─── Appointment & Queue ───────────────────────────────────

model Appointment {
  id           String            @id @default(cuid())
  patientId    String
  doctorId     String
  hospitalId   String
  date         DateTime
  timeSlot     String            // e.g., "09:00-09:30"
  tokenNumber  Int?
  status       AppointmentStatus @default(SCHEDULED)
  reason       String?
  notes        String?
  checkedInAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@index([doctorId, date])
  @@index([hospitalId, date])
  @@index([patientId])
  @@index([status])
}

// ─── Triage ────────────────────────────────────────────────

model TriageRecord {
  id                  String        @id @default(cuid())
  patientId           String
  symptoms            String[]
  vitalsSystolic      Int?
  vitalsDiastolic     Int?
  vitalsTemperature   Float?
  vitalsHeartRate     Int?
  vitalsOxygen        Float?
  urgency             TriageUrgency
  recommendedSpecialist String?
  suggestedFacility   FacilityLevel?
  redFlags            String[]
  aiConfidence        Float?
  notes               String?
  triageDate          DateTime      @default(now())
  createdAt           DateTime      @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([urgency])
  @@index([triageDate])
}

// ─── ASHA Worker ───────────────────────────────────────────

model AshaWorker {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  phone        String
  assignedArea String
  village      String?
  district     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  visits AshaVisit[]

  @@index([assignedArea])
}

model AshaVisit {
  id            String   @id @default(cuid())
  ashaWorkerId  String
  patientId     String?
  visitType     String   // household_visit, patient_registration, follow_up, etc.
  householdId   String?
  notes         String?
  vitalsRecorded Json?   // flexible vitals storage
  isSynced      Boolean  @default(false)
  visitDate     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ashaWorker AshaWorker @relation(fields: [ashaWorkerId], references: [id], onDelete: Cascade)
  patient    Patient?   @relation(fields: [patientId], references: [id])

  @@index([ashaWorkerId])
  @@index([patientId])
  @@index([isSynced])
  @@index([visitDate])
}

// ─── Inventory ─────────────────────────────────────────────

model Medicine {
  id            String   @id @default(cuid())
  hospitalId    String
  name          String
  genericName   String?
  category      String?
  quantity       Int      @default(0)
  unit          String?  // tablets, ml, etc.
  expiryDate    DateTime?
  reorderLevel  Int      @default(10)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([name])
  @@index([isAvailable])
}

model Machine {
  id                String   @id @default(cuid())
  hospitalId        String
  name              String
  type              String?  // X-ray, MRI, CT, Ultrasound, etc.
  operatorsAvailable Int     @default(0)
  testsPerformable  String[] // list of tests this machine can do
  isOperational     Boolean  @default(true)
  lastMaintenance   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([isOperational])
}

model Pharmacy {
  id                  String   @id @default(cuid())
  hospitalId          String
  pharmacistsAvailable Int     @default(0)
  dispensariesCount   Int      @default(1)
  isOpen              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}
