GROQ_API_KEY=your_rotated_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Persistence (Phase 5). Local/demo default is a SQLite file; a hosted
# deploy would point this at a PostgreSQL URL instead — no code change
# needed elsewhere.
DATABASE_URL=sqlite:///./app.db

# Optional. Only used by backend/app/seed.py to create demo RoleAssignment
# rows (email -> role mapping used for first-login bootstrap in a later
# phase). Leave unset to skip seeding any role assignment. Never commit
# real personal email addresses here.
# DEMO_WORKER_EMAIL=
# DEMO_FACILITY_EMAIL=
# DEMO_ADMIN_EMAIL=
